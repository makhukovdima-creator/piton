<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#101418">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐍 Питон — настройки"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Адрес сервера:"
        android:textColor="#AAAAAA" />

    <EditText
        android:id="@+id/et_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://..."
        android:inputType="textUri"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:backgroundTint="#3A424C"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_find"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📡 Найти сервер по маяку"
        android:backgroundTint="#1F4E79"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Токен:"
        android:textColor="#AAAAAA" />

    <EditText
        android:id="@+id/et_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="введи токен с сервера (piton_config.json)"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:backgroundTint="#3A424C"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить и открыть Питона"
        android:backgroundTint="#2E7D5B" />
</LinearLayout>
